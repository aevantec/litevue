{
  "name": "@aevantec/litevue",
  "version": "0.5.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Lightweight subset of Vue optimized for progressive enhancement. A fork of petite-vue with devtools.",
  "type": "commonjs",
  "//sideEffects": "The core auto-mounts when its script tag has `init`, and the devtools panel self-initializes on import — both are real import side effects and must not be tree-shaken. The plugins bundle is pure, so bundlers may drop unused plugins.",
  "sideEffects": [
    "./dist/litevue.*",
    "./dist/litevue-devtools.*"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/litevue.umd.js",
  "unpkg": "dist/litevue.iife.js",
  "jsdelivr": "dist/litevue.iife.js",
  "module": "./dist/litevue.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/litevue.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/litevue.umd.js"
      }
    },
    "./plugins": {
      "import": {
        "types": "./dist/types/plugins/index.d.mts",
        "default": "./dist/litevue-plugins.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/index.d.ts",
        "default": "./dist/litevue-plugins.umd.js"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/types/devtools-panel.d.mts",
        "default": "./dist/litevue-devtools.mjs"
      },
      "require": {
        "types": "./dist/types/devtools-panel.d.ts",
        "default": "./dist/litevue-devtools.umd.js"
      }
    },
    "./plugins/collapse": {
      "import": {
        "types": "./dist/types/plugins/collapse/index.d.mts",
        "default": "./dist/plugins/collapse.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/collapse/index.d.ts",
        "default": "./dist/plugins/collapse.umd.js"
      }
    },
    "./plugins/focus": {
      "import": {
        "types": "./dist/types/plugins/focus/index.d.mts",
        "default": "./dist/plugins/focus.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/focus/index.d.ts",
        "default": "./dist/plugins/focus.umd.js"
      }
    },
    "./plugins/intersect": {
      "import": {
        "types": "./dist/types/plugins/intersect/index.d.mts",
        "default": "./dist/plugins/intersect.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/intersect/index.d.ts",
        "default": "./dist/plugins/intersect.umd.js"
      }
    },
    "./plugins/mask": {
      "import": {
        "types": "./dist/types/plugins/mask/index.d.mts",
        "default": "./dist/plugins/mask.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/mask/index.d.ts",
        "default": "./dist/plugins/mask.umd.js"
      }
    },
    "./plugins/morph": {
      "import": {
        "types": "./dist/types/plugins/morph/index.d.mts",
        "default": "./dist/plugins/morph.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/morph/index.d.ts",
        "default": "./dist/plugins/morph.umd.js"
      }
    },
    "./plugins/persist": {
      "import": {
        "types": "./dist/types/plugins/persist/index.d.mts",
        "default": "./dist/plugins/persist.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/persist/index.d.ts",
        "default": "./dist/plugins/persist.umd.js"
      }
    },
    "./plugins/transition": {
      "import": {
        "types": "./dist/types/plugins/transition/index.d.mts",
        "default": "./dist/plugins/transition.mjs"
      },
      "require": {
        "types": "./dist/types/plugins/transition/index.d.ts",
        "default": "./dist/plugins/transition.umd.js"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "plugins": [
        "./dist/types/plugins/index.d.ts"
      ],
      "devtools": [
        "./dist/types/devtools-panel.d.ts"
      ],
      "plugins/collapse": [
        "./dist/types/plugins/collapse/index.d.ts"
      ],
      "plugins/focus": [
        "./dist/types/plugins/focus/index.d.ts"
      ],
      "plugins/intersect": [
        "./dist/types/plugins/intersect/index.d.ts"
      ],
      "plugins/mask": [
        "./dist/types/plugins/mask/index.d.ts"
      ],
      "plugins/morph": [
        "./dist/types/plugins/morph/index.d.ts"
      ],
      "plugins/persist": [
        "./dist/types/plugins/persist/index.d.ts"
      ],
      "plugins/transition": [
        "./dist/types/plugins/transition/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.devtools.config.mts && vite build --config vite.plugins.config.mts && node scripts/build-plugins.mjs && pnpm build:types",
    "build:types": "tsc --emitDeclarationOnly && mv dist/src dist/types && node scripts/build-types.mjs",
    "lint:package": "publint --strict && attw --pack .",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check:docs-versions": "node scripts/check-docs-versions.mjs",
    "prepublishOnly": "pnpm build && publint --strict",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "prettier --write \"**/*.{ts,mts,js,html,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aevantec/litevue.git"
  },
  "keywords": [
    "vue",
    "petite-vue",
    "litevue",
    "alpine",
    "alpinejs",
    "progressive-enhancement",
    "reactivity",
    "directives",
    "no-build",
    "devtools",
    "lightweight",
    "frontend"
  ],
  "author": "abiacarl <abiacarl@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aevantec/litevue/issues"
  },
  "homepage": "https://litevue.dev",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.30.3",
  "dependencies": {
    "@vue/reactivity": "~3.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@vue/shared": "~3.4.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.0",
    "publint": "^0.3.22",
    "terser": "^5.36.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "contributors": [
    "Evan You (petite-vue, which this is forked from)"
  ]
}
