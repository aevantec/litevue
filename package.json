{
  "name": "litevue",
  "version": "0.5.0",
  "description": "Lightweight subset of Vue optimized for progressive enhancement. A fork of petite-vue with devtools.",
  "files": [
    "dist"
  ],
  "main": "dist/lite-vue.umd.js",
  "unpkg": "dist/lite-vue.iife.js",
  "jsdelivr": "dist/lite-vue.iife.js",
  "module": "./dist/lite-vue.es.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lite-vue.es.js",
      "require": "./dist/lite-vue.umd.js"
    },
    "./plugins": {
      "types": "./dist/types/plugins/index.d.ts",
      "import": "./dist/lite-vue-plugins.es.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "plugins": [
        "./dist/types/plugins/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.devtools.config.ts && vite build --config vite.plugins.config.ts && tsc --emitDeclarationOnly && mv dist/src dist/types",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "format": "prettier --write \"**/*.{ts,js,html,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abiacarl/litevue.git"
  },
  "keywords": [
    "vue"
  ],
  "author": "Evan You",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abiacarl/litevue/issues"
  },
  "homepage": "https://github.com/abiacarl/litevue#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@vue/reactivity": "~3.4.0"
  },
  "devDependencies": {
    "@vue/shared": "~3.4.0",
    "chalk": "^4.1.1",
    "conventional-changelog-cli": "^2.1.1",
    "enquirer": "^2.3.6",
    "execa": "^5.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.0",
    "semver": "^7.3.5",
    "terser": "^5.36.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
